# Genera uno con: openssl rand -base64 32 (obligatorio en producción, >= 32 caracteres)
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-largo
# URL pública de la app (origen de confianza para cookies y redirecciones)
BETTER_AUTH_URL=http://localhost:4321
# Local: fichero SQLite. En Vercel: libsql://… de Turso (un fichero no persiste)
DATABASE_URL=file:./data/barber.db
# Solo para libsql:// (Turso)
DATABASE_AUTH_TOKEN=
SHOP_TIMEZONE=America/Bogota
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SHOP_CURRENCY=COP
