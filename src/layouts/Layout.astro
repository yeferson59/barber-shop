---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getSettings } from "@/lib/settings";

interface Props {
  title?: string;
  description?: string;
  /** Oculta header/footer (p. ej. login). */
  bare?: boolean;
}

const { title, description, bare = false } = Astro.props;
const settings = await getSettings();
const fullTitle = title ? `${title} | ${settings.name}` : settings.name;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content={description ?? `Reserva tu cita en ${settings.name}.`}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400..800&family=Ultra&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    {!bare && <Header shopName={settings.name} />}
    <main class="flex-1">
      <slot />
    </main>
    {!bare && <Footer settings={settings} />}
  </body>
</html>
