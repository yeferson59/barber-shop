---
import Logo from "./Logo.astro";
import LogoutButton from "./LogoutButton.astro";

interface Props {
  shopName: string;
}
const { shopName } = Astro.props;
const user = Astro.locals.user;
const isStaff = user?.role === "admin" || user?.role === "barber";
const path = Astro.url.pathname;

const links = [
  { href: "/#precios", label: "Precios" },
  { href: "/disponibilidad", label: "Disponibilidad" },
  ...(user ? [{ href: "/mis-citas", label: "Mis citas" }] : []),
  ...(isStaff ? [{ href: "/panel", label: "Panel" }] : []),
];
---

<header class="sticky top-0 z-30 border-b border-junta bg-loza/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex min-w-0 items-center gap-2.5 text-botella">
      <Logo class="h-9 w-4.5 shrink-0" />
      <span class="font-display text-[15px] leading-tight sm:text-xl">
        {shopName}
      </span>
    </a>

    <nav class="hidden items-center gap-6 text-[15px] md:flex">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            "font-medium underline-offset-[6px] hover:underline",
            path === l.href
              ? "underline decoration-poste decoration-2"
              : "decoration-junta decoration-2",
          ]}
        >
          {l.label}
        </a>
      ))}
      {user ? (
        <LogoutButton class="font-medium text-cromo hover:text-botella" />
      ) : (
        <a href="/login" class="font-medium">
          Entrar
        </a>
      )}
      <a href="/agendar" class="btn-primary">
        Reservar cita
      </a>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <a href="/agendar" class="btn-primary btn-sm">
        Reservar
      </a>
      <details class="relative">
        <summary
          class="flex cursor-pointer list-none items-center rounded-md p-2 hover:bg-azulejo"
          aria-label="Abrir menú"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <nav class="absolute right-0 mt-2 flex w-56 flex-col rounded-lg border border-junta bg-loza p-2 text-[15px] shadow-lg">
          {links.map((l) => (
            <a href={l.href} class="rounded px-3 py-2.5 hover:bg-azulejo">
              {l.label}
            </a>
          ))}
          {user ? (
            <LogoutButton class="rounded px-3 py-2.5 text-left text-cromo hover:bg-azulejo" />
          ) : (
            <a href="/login" class="rounded px-3 py-2.5 hover:bg-azulejo">
              Entrar
            </a>
          )}
        </nav>
      </details>
    </div>
  </div>
</header>
