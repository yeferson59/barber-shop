---
import Logo from "./Logo.astro";
import { googleEnabled } from "@/auth";

interface Props {
  title: string;
  subtitle: string;
}
const { title, subtitle } = Astro.props;
const next = Astro.url.searchParams.get("next") ?? "";
---

<div class="tile-wall flex min-h-[calc(100vh-4rem)] items-start justify-center px-4 py-12 sm:items-center">
  <div class="w-full max-w-md rounded-xl border border-junta bg-loza p-6 shadow-[0_1px_0_var(--color-junta)] sm:p-8">
    <Logo class="h-12 w-6 text-botella" />
    <h1 class="mt-5 text-4xl">{title}</h1>
    <p class="mt-2 text-botella-2">{subtitle}</p>

    {googleEnabled && (
      <>
        <button
          type="button"
          class="btn-ghost mt-7 w-full py-3"
          data-google
          data-next={next}
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="#EA4335"
              d="M12 10.2v3.9h5.5c-.2 1.3-1.6 3.9-5.5 3.9-3.3 0-6-2.7-6-6.1s2.7-6.1 6-6.1c1.9 0 3.1.8 3.8 1.5l2.6-2.5C16.8 3.3 14.6 2.3 12 2.3 6.6 2.3 2.3 6.6 2.3 12s4.3 9.7 9.7 9.7c5.6 0 9.3-3.9 9.3-9.5 0-.6-.1-1.1-.2-1.6H12z"
            />
          </svg>
          Seguir con Google
        </button>
        <div class="my-6 flex items-center gap-3 text-sm text-cromo">
          <span class="h-px flex-1 bg-junta" />o con tu correo
          <span class="h-px flex-1 bg-junta" />
        </div>
      </>
    )}
    <div class:list={[!googleEnabled && "mt-7"]}>
      <slot />
    </div>
  </div>
</div>

<script>
  import { authClient } from "../lib/auth-client";

  const btn = document.querySelector<HTMLButtonElement>("[data-google]");
  btn?.addEventListener("click", async () => {
    btn.disabled = true;
    await authClient.signIn.social({
      provider: "google",
      callbackURL: btn.dataset.next || "/",
    });
  });
</script>
