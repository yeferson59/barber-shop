---
import Layout from "@/layouts/Layout.astro";
import BookingWizard from "@/components/islands/BookingWizard";
import { getAppointment } from "@/lib/booking";
import { getBookingCatalog } from "@/lib/catalog";
import { getSettings } from "@/lib/settings";
import { fmt } from "@/lib/time";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/login?next=/mis-citas");
const appt = await getAppointment(Astro.params.id!);
const settings = await getSettings();
if (
  !appt ||
  appt.clientId !== user.id ||
  appt.status !== "confirmed" ||
  appt.startsAt.getTime() - settings.cancelLimitHours * 3_600_000 <= Date.now()
) {
  return Astro.redirect("/mis-citas");
}
const catalog = await getBookingCatalog();
---

<Layout title="Cambiar cita">
  <div class="mx-auto max-w-6xl px-4 pt-12 pb-28 sm:px-6 sm:pt-16 lg:pb-20">
    <a href="/mis-citas" class="link text-sm">
      Volver a mis citas
    </a>
    <h1 class="mt-4 text-5xl sm:text-6xl">Cambiar la cita</h1>
    <p class="mt-4 max-w-xl text-lg text-botella-2">
      {appt.service.name} con {appt.barber.name}, ahora el{" "}
      {fmt(appt.startsAt, "EEEE d 'de' MMMM 'a las' HH:mm")}. Elige el nuevo
      momento.
    </p>
    <div class="mt-10">
      <BookingWizard
        client:load
        {...catalog}
        loggedIn
        reschedule={{
          appointmentId: appt.id,
          serviceId: appt.serviceId,
          barberId: appt.barberId,
        }}
      />
    </div>
  </div>
</Layout>
