---
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/AuthCard.astro";
import { safeNext } from "@/lib/next";

const next = safeNext(Astro.url.searchParams.get("next"));

if (Astro.locals.user) return Astro.redirect(next || "/");
---

<Layout title="Entrar">
  <AuthCard title="Entrar" subtitle="Para reservar y ver o cambiar tus citas.">
    <form id="login-form" class="space-y-4" data-next={next}>
      <div>
        <label class="label" for="email">
          Correo
        </label>
        <input
          class="input"
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
        />
      </div>
      <div>
        <label class="label" for="password">
          Contraseña
        </label>
        <input
          class="input"
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />
      </div>
      <p class="alert-error hidden" data-error></p>
      <button class="btn-primary w-full py-3.5 text-base" type="submit">
        Entrar
      </button>
    </form>
    <p class="mt-6 text-botella-2">
      ¿Primera vez?{" "}
      <a
        class="link"
        href={`/registro${next ? `?next=${encodeURIComponent(next)}` : ""}`}
      >
        Crea tu cuenta
      </a>
    </p>
  </AuthCard>
</Layout>

<script>
  import { authClient } from "@/lib/auth-client";

  const form = document.querySelector<HTMLFormElement>("#login-form")!;
  const error = form.querySelector<HTMLElement>("[data-error]")!;
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = form.querySelector("button")!;
    btn.disabled = true;
    error.classList.add("hidden");
    const data = new FormData(form);
    const { error: err } = await authClient.signIn.email({
      email: String(data.get("email")),
      password: String(data.get("password")),
    });
    if (err) {
      error.textContent =
        err.status === 401
          ? "El correo o la contraseña no coinciden. Revísalos e inténtalo de nuevo."
          : (err.message ?? "No se pudo iniciar sesión.");
      error.classList.remove("hidden");
      btn.disabled = false;
      return;
    }
    window.location.href = form.dataset.next || "/";
  });
</script>
