---
import { actions } from "astro:actions";
import Layout from "@/layouts/Layout.astro";
import ActionAlert from "@/components/ActionAlert.astro";
import Logo from "@/components/Logo.astro";
import LogoutButton from "@/components/LogoutButton.astro";
import { findClientInvite, isPlaceholderEmail } from "@/lib/invite";

// Público: lo abre un cliente creado desde el panel, que aún no puede entrar.
const done = Astro.getActionResult(actions.clients.activate)?.data;
const token = Astro.params.token ?? "";
const client = done ? undefined : await findClientInvite(token);
const me = Astro.locals.user;
---

<Layout title="Activar tu cuenta">
  <div class="tile-wall flex min-h-[calc(100vh-4rem)] items-start justify-center px-4 py-12 sm:items-center">
    <div class="w-full max-w-md rounded-xl border border-junta bg-loza p-6 shadow-[0_1px_0_var(--color-junta)] sm:p-8">
      <Logo class="h-12 w-6 text-botella" />
      {done ? (
        <>
          <h1 class="mt-5 text-4xl">Cuenta activada</h1>
          <p class="mt-2 text-botella-2">
            Ya puedes entrar con <strong>{done.email}</strong> y tu contraseña
            para ver, cambiar o cancelar tus citas.
          </p>
          <a class="btn-primary mt-7 w-full py-3" href="/login?next=/mis-citas">
            Entrar
          </a>
        </>
      ) : !client ? (
        <>
          <h1 class="mt-5 text-4xl">Enlace no válido</h1>
          <p class="mt-2 text-botella-2">
            Ha caducado o ya se usó. Pide uno nuevo en la barbería.
          </p>
          <a class="link mt-6 inline-block" href="/">Volver al inicio</a>
        </>
      ) : me ? (
        <>
          <h1 class="mt-5 text-4xl">Hola, {client.name}</h1>
          <p class="mt-2 text-botella-2">
            Ahora tienes la sesión iniciada como {me.email}. Sal y vuelve a abrir
            este enlace para activar tu cuenta.
          </p>
          <LogoutButton class="btn-ghost mt-6" />
        </>
      ) : (
        <>
          <h1 class="mt-5 text-4xl">Hola, {client.name}</h1>
          <p class="mt-2 text-botella-2">
            Elige una contraseña para entrar en la web y gestionar tus citas.
          </p>
          <div class="mt-5">
            <ActionAlert actions={[actions.clients.activate]} />
          </div>
          <form method="POST" action={actions.clients.activate} class="space-y-4">
            <input type="hidden" name="token" value={token} />
            <div>
              <label class="label" for="email">Correo</label>
              <input
                class="input"
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                value={isPlaceholderEmail(client.email) ? "" : client.email}
                required
              />
            </div>
            <div>
              <label class="label" for="password">Contraseña</label>
              <input
                class="input"
                id="password"
                name="password"
                type="password"
                minlength="8"
                autocomplete="new-password"
                required
              />
              <p class="mt-1.5 text-sm text-cromo">Mínimo 8 caracteres.</p>
            </div>
            <button class="btn-primary w-full py-3.5 text-base">
              Activar mi cuenta
            </button>
          </form>
        </>
      )}
    </div>
  </div>
</Layout>
