---
import { actions } from "astro:actions";
import { asc, desc, inArray } from "drizzle-orm";
import PanelLayout from "@/layouts/PanelLayout.astro";
import ActionAlert from "@/components/ActionAlert.astro";
import { db } from "@/db";
import { barber, barberService, service, user } from "@/db/schema";
import { fmt } from "@/lib/time";

if (Astro.locals.user?.role !== "admin") return Astro.redirect("/panel");

const [barbers, services, links] = await Promise.all([
  db.select().from(barber).orderBy(desc(barber.active), asc(barber.name)),
  db.select().from(service).orderBy(asc(service.name)),
  db.select().from(barberService),
]);
const userIds = barbers.flatMap((b) => (b.userId ? [b.userId] : []));
const users = userIds.length
  ? await db
      .select({ id: user.id, email: user.email })
      .from(user)
      .where(inArray(user.id, userIds))
  : [];
const emailOf = (id: string | null) =>
  users.find((u) => u.id === id)?.email ?? "";
const offers = (b: string, s: string) =>
  links.some((l) => l.barberId === b && l.serviceId === s);

// El token solo existe en esta respuesta: en la BD se guarda su hash.
const invited = Astro.getActionResult(actions.barbers.invite);
const invite = invited?.data
  ? {
      id: invited.data.id,
      url: new URL(`/unirse/${invited.data.token}`, Astro.url).href,
      expiresAt: invited.data.expiresAt,
    }
  : null;
const now = new Date();
const expiry = (d: Date) => fmt(d, "d 'de' MMMM 'a las' HH:mm");
---

<PanelLayout title="Barberos">
  <ActionAlert actions={[actions.barbers.save, actions.barbers.unlink]} />
  {invited?.error && (
    <p class="alert-error mb-4" role="alert">{invited.error.message}</p>
  )}

  {[...barbers, null].map((b) => (
    <details
      class:list={["card mb-3", b && !b.active && "opacity-60"]}
      open={b ? invite?.id === b.id : barbers.length === 0}
    >
      <summary class="flex cursor-pointer items-center justify-between px-5 py-4">
        <span class="font-semibold">
          {b ? b.name : "+ Añadir barbero"}
          {b && !b.active && (
            <span class="badge ml-2 bg-junta text-botella-2">Inactivo</span>
          )}
        </span>
        {b && (
          <span class="text-sm text-cromo">
            {emailOf(b.userId) || "Sin cuenta vinculada"}
          </span>
        )}
      </summary>
      <form
        method="POST"
        action={actions.barbers.save}
        class="grid gap-4 border-t border-junta px-5 py-4 md:grid-cols-2"
      >
        {b && <input type="hidden" name="id" value={b.id} />}
        <div>
          <label class="label">Nombre</label>
          <input class="input" name="name" value={b?.name ?? ""} required />
        </div>
        <div class="md:col-span-2">
          <label class="label">Bio</label>
          <input class="input" name="bio" value={b?.bio ?? ""} />
        </div>
        <div class="md:col-span-2">
          <label class="label">URL de foto</label>
          <input
            class="input"
            name="photoUrl"
            type="url"
            value={b?.photoUrl ?? ""}
            placeholder="https://…"
          />
        </div>
        <fieldset class="md:col-span-2">
          <legend class="label">Servicios que realiza</legend>
          <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
            {services.map((s) => (
              <label class="flex items-center gap-2">
                <input
                  type="checkbox"
                  name="serviceIds"
                  value={s.id}
                  checked={b ? offers(b.id, s.id) : s.active}
                />
                {s.name}
              </label>
            ))}
          </div>
        </fieldset>
        {b && (
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" name="active" checked={b.active} /> Activo
            (recibe reservas)
          </label>
        )}
        <div class="flex justify-end md:col-span-2">
          <button class="btn-primary">{b ? "Guardar" : "Crear barbero"}</button>
        </div>
      </form>
      {b && (
        <div class="border-t border-junta px-5 py-4">
          <p class="label">Acceso al panel</p>
          <p class="text-sm">
            {b.userId
              ? `Vinculado a ${emailOf(b.userId)}.`
              : "Sin cuenta vinculada. Genera un enlace y envíaselo para que acceda a su agenda."}
          </p>
          {invite?.id === b.id ? (
            <div class="mt-3">
              <label class="label" for={`invite-${b.id}`}>
                Enlace de invitación
              </label>
              <div class="flex gap-2">
                <input
                  id={`invite-${b.id}`}
                  class="input"
                  readonly
                  value={invite.url}
                />
                <button type="button" class="btn-ghost" data-copy={invite.url}>
                  Copiar
                </button>
              </div>
              <p class="mt-1 text-xs text-cromo">
                Envíaselo por WhatsApp o en persona. Lo abre con su cuenta
                iniciada (con correo o Google) y queda vinculado. Sirve una sola
                vez, caduca el {expiry(invite.expiresAt)} y no se vuelve a
                mostrar.
              </p>
            </div>
          ) : (
            b.inviteHash &&
            b.inviteExpiresAt &&
            b.inviteExpiresAt > now && (
              <p class="mt-1 text-xs text-cromo">
                Hay un enlace sin usar que caduca el {expiry(b.inviteExpiresAt)}.
                Si generas otro, el anterior deja de valer.
              </p>
            )
          )}
          <div class="mt-3 flex flex-wrap gap-2">
            <form method="POST" action={actions.barbers.invite}>
              <input type="hidden" name="id" value={b.id} />
              <button class="btn-ghost btn-sm">
                {b.userId ? "Enlace para cambiar de cuenta" : "Generar enlace"}
              </button>
            </form>
            {b.userId && (
              <form
                method="POST"
                action={actions.barbers.unlink}
                data-confirm={`¿Quitar a ${b.name} el acceso al panel?`}
              >
                <input type="hidden" name="id" value={b.id} />
                <button class="btn-danger btn-sm">Quitar acceso</button>
              </form>
            )}
          </div>
        </div>
      )}
    </details>
  ))}
  <p class="mt-4 text-sm text-cromo">
    Después de crear un barbero, configura su{" "}
    <a
      class="text-botella underline decoration-junta decoration-2 underline-offset-4 hover:underline"
      href="/panel/horarios"
    >
      horario
    </a>
    .
  </p>
</PanelLayout>
